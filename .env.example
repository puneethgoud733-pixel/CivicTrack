# CivicTrack Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file with real secrets to git!

# ==================================
# GEMINI AI Configuration
# ==================================
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==================================
# Flask Configuration
# ==================================
# Generate a secure random key for production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here
FLASK_ENV=development

# ==================================
# Database Configuration (Optional)
# ==================================
# SQLite (default - no configuration needed)
# For PostgreSQL, uncomment below and update:
# DATABASE_URL=postgresql://username:password@localhost:5432/civictrack

# ==================================
# Optional: Server Configuration
# ==================================
# DEBUG=True
# TESTING=False
